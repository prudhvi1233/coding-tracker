{
  "name": "coding-tracker",
  "displayName": "Coding Tracker",
  "description": "Tracks coding activity and sends it to a backend.",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codingTracker.enable",
        "title": "Coding Tracker: Enable Tracking"
      },
      {
        "command": "codingTracker.disable",
        "title": "Coding Tracker: Disable"
      },
      {
        "command": "codingTracker.showStatus",
        "title": "Coding Tracker: Show Status"
      },
      {
        "command": "codingTracker.saveSnapshot",
        "title": "Coding Tracker: Save Manual Snapshot"
      },
      {
        "command": "codingTracker.refreshGitData",
        "title": "Coding Tracker: Refresh Git Data"
      }
    ],
    "configuration": {
      "title": "Coding Tracker",
      "properties": {
        "codingTracker.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable coding activity tracking."
        },
        "codingTracker.apiUrl": {
          "type": "string",
          "default": "http://localhost:5000/api",
          "description": "Backend API URL"
        },
        "codingTracker.deviceToken": {
          "type": "string",
          "default": "",
          "description": "Device Token generated from your web dashboard"
        },
        "codingTracker.ignoredFolders": {
          "type": "array",
          "default": [
            "node_modules",
            ".git",
            "dist",
            "build",
            "coverage"
          ],
          "description": "Folders to ignore"
        },
        "codingTracker.maxFileSize": {
          "type": "number",
          "default": 1048576,
          "description": "Maximum file size to track in bytes"
        },
        "codingTracker.snapshotsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable automatic code snapshots."
        },
        "codingTracker.snapshotIntervalMinutes": {
          "type": "number",
          "default": 10,
          "description": "Interval between automatic snapshots in minutes."
        },
        "codingTracker.maxSnapshotFileSize": {
          "type": "number",
          "default": 1048576,
          "description": "Maximum file size for snapshots in bytes."
        },
        "codingTracker.manualSnapshotEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Allow manual code snapshots."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "webpack": "^5.80.0",
    "webpack-cli": "^5.1.0"
  }
}
